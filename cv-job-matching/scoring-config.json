{
  "scoring_version": "1.1.0",
  "description": "Configuration du moteur de matching déterministe Boussole. Toute modification exige un run d'évaluation (voir 06-matching-specification.md §5).",
  "min_known_weight_ratio": 0.4,
  "extraction_confidence_floor": 0.5,
  "blocking_confidence_floor": 0.7,
  "dimensions": {
    "skills_required": {
      "weight": 25,
      "method": "coverage",
