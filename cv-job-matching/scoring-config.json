      "exact_credit": 1.0,
      "related_credit": 0.5,
      "related_similarity_threshold": 0.75
    },
    "title_similarity": {
      "weight": 15,
      "method": "embedding_piecewise",
      "zero_below": 0.55,
      "one_above": 0.8,
      "calibrated_for_model": null,
      "calibrated_for_model_note": "null = ces seuils n'ont ete calibres contre AUCUN modele. La dimension est donc INCONNUE (renormalisee hors du score ET de la confiance) au lieu de rendre un sous-score que rien ne fonde. Y mettre l'identifiant de modele le jour ou zero_below/one_above auront ete mesures contre lui (Q11 puis Q12) : c'est cette ligne qui reactive les 15 % de poids."
    },
    "seniority": {
      "weight": 8,
      "method": "ordinal_table",
      "levels": [
        "intern",
        "junior",
        "mid",
        "senior",
        "lead",
        "principal",
        "executive"
      ],
      "delta_scores": {
        "0": 1.0,
