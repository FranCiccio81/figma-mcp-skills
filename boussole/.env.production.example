# Boussole — configuration de PRODUCTION (VPS).
#
#     cp .env.production.example .env     puis remplir, puis :
#     docker compose -f infra/docker-compose.prod.yml --env-file .env up -d
#
# Les variables marquées ⛔ font ÉCHOUER LE DÉMARRAGE si elles sont mal
# réglées. C'est délibéré : refuser de démarrer vaut mieux que démarrer en
# trahissant une garantie. La liste complète est au §2.4 ter du runbook.
#
# Ne jamais committer ce fichier une fois rempli.

# ---------------------------------------------------------------- domaine
# Le nom de domaine doit DÉJÀ pointer (A/AAAA) sur l'IP du VPS avant le
# premier démarrage : Caddy demande le certificat au boot, et Let's Encrypt
# vérifie le DNS. Sinon le conteneur boucle sur des échecs ACME.
PUBLIC_HOSTNAME=boussole.exemple.fr
ACME_EMAIL=admin@exemple.fr

# ------------------------------------------------------------------ base
# Mot de passe du rôle PostgreSQL. Généré, jamais choisi à la main :
#     openssl rand -base64 32
POSTGRES_PASSWORD=

# Chaque worker uvicorn ouvre son propre pool (5 + 10), chaque worker Celery
# aussi. Garder max_connections > WEB_CONCURRENCY × 15 + marge Celery.
POSTGRES_MAX_CONNECTIONS=200

# ------------------------------------------------------------- capacité
# Workers uvicorn dans le conteneur API. Mesuré : ~15 req/s et ~5
# utilisateurs simultanés confortables PAR PROCESSUS (runbook §5.5).
# Compter 2 par cœur disponible comme point de départ.
WEB_CONCURRENCY=2

# Mémoire du Redis de cache. Sa perte est acceptable (D17) : il ne porte que
# cache, limitation de débit et quotas.
REDIS_CACHE_MAXMEMORY=512mb

# ------------------------------------------------------------- ⛔ secrets
# Signe SEULE l'accès aux liens de téléchargement d'export RGPD — une archive
# contenant l'intégralité des données d'un compte. La valeur de développement
# est publique (elle est dans le dépôt) : laissée en place, n'importe qui
# ayant lu le code forge un lien valide.
#     openssl rand -base64 48
PRIVACY_SIGNING_KEY=

# ------------------------------------------------------- ⛔ stockage objet
# **Décision à prendre.** Le stockage doit être S3 et chiffré au repos —
# `STORAGE_BACKEND=local` et `S3_SSE=none` sont refusés au démarrage (D09).
#
# MinIO auto-hébergé sur le VPS ne convient PAS sans KES : il ne sait pas
# chiffrer côté serveur, donc `S3_SSE` ne peut pas être satisfait. Et les CV
# comme les exports RGPD vivraient sur le disque unique du VPS, sans
# réplication.
#
# Retenir un fournisseur S3 dans l'UE. Exemples compatibles :
#   Scaleway  https://s3.fr-par.scw.cloud     region fr-par
#   OVH       https://s3.gra.io.cloud.ovh.net region gra
#   Backblaze https://s3.eu-central-003.backblazeb2.com
#
# `S3_ADDRESSING_STYLE=path` si le fournisseur ne gère pas le style virtuel.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=fr-par
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SSE=AES256
S3_KMS_KEY_ID=
S3_ADDRESSING_STYLE=virtual

# ----------------------------------------------------------- ⛔ e-mail
# `SMTP_STARTTLS` est forcé à true par le compose : sans lui, l'adresse de
# chaque destinataire — et le mot de passe SMTP — transiteraient en clair, et
# le démarrage est refusé.
#
# ⚠️ Ne PAS pointer sur mailpit : il avale tout, personne ne recevrait rien,
# et rien ne le signalerait.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Boussole <no-reply@exemple.fr>

# ------------------------------------------------------------ observabilité
# Fortement recommandé : c'est ce qui fait qu'une alerte de purge RGPD en
# retard atteint un humain. L'extra `[observability]` est installé dans
# l'image, donc un DSN renseigné démarre normalement.
SENTRY_DSN=

# ---------------------------------------------------------------------- IA
# `fake` = explications et générations sortent des textes canned, aucun appel
# externe, aucun coût. C'est le défaut, et c'est le bon pour une première
# mise en ligne.
#
# ⚠️ Passer à `anthropic` a des prérequis NON LIVRÉS : filtrage des attributs
# sensibles avant prompt et détecteur d'injection. Ne pas le faire sans les
# avoir traités.
AI_PROVIDER=fake
ANTHROPIC_API_KEY=
