# Boussole — variables d'environnement (valeurs de développement).
# AUCUN secret réel ici (D23) : en staging/prod, tout vient du vault.
# Copier vers api/.env pour le développement local hors Docker.

# Environnement : development | staging | production
ENV=development
DEBUG=false

# PostgreSQL 16 + pgvector (D06) — driver asyncpg obligatoire.
DATABASE_URL=postgresql+asyncpg://boussole:boussole@localhost:5432/boussole

# Deux Redis logiques (D17).
REDIS_PERSISTENT_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6380/0

# Stockage objet UE (D09) — MinIO en dev, S3 UE en staging/production.
#
# STORAGE_BACKEND=local écrit sur le disque DU CONTENEUR COURANT : réservé aux
# tests et au dev mono-processus (aucun worker Celery séparé). Dès que l'API et
# les workers sont deux processus/conteneurs, il FAUT s3 — sinon le worker écrit
# l'archive d'export RGPD sur son disque, l'API la relit depuis le sien, et le
# téléchargement répond 404 (les CV disparaissent aussi au redémarrage).
# En production, STORAGE_BACKEND=local fait ÉCHOUER le démarrage
# (app/core/storage.py::check_storage_configuration).
STORAGE_BACKEND=s3
STORAGE_LOCAL_PATH=.storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=boussole-dev
S3_REGION=eu-west-1
S3_ACCESS_KEY=boussole-dev
S3_SECRET_KEY=boussole-dev-secret

# Clé HMAC des liens signés de téléchargement des archives d'export RGPD.
# ⚠️ La valeur ci-dessous est celle du dépôt, donc PUBLIQUE : elle permet de
# forger un lien vers le dump personnel complet de n'importe quel compte.
# Hors développement, l'API et les workers REFUSENT DE DÉMARRER tant qu'elle
# n'est pas remplacée par une valeur issue du vault (D23).
PRIVACY_SIGNING_KEY=boussole-dev-privacy-signing
# Chiffrement au repos (09 §5.6, D09/D23) : aws:kms (+ S3_KMS_KEY_ID) en
# staging/production ; AES256 (SSE-S3) est le minimum acceptable ; none est
# réservé au dev sur MinIO (pas de KES) et refusé au démarrage en production.
S3_SSE=none
S3_KMS_KEY_ID=
# auto ⇒ « path » dès qu'un S3_ENDPOINT explicite est configuré (MinIO).
S3_ADDRESSING_STYLE=path
# Bornes réseau botocore (un worker ne doit jamais rester suspendu).
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=30
S3_MAX_ATTEMPTS=3

# Le bucket est créé au démarrage par le service « minio-init » du compose de
# dev (mc mb --ignore-existing + versionnement). Création manuelle :
#   docker run --rm --network boussole-dev minio/mc sh -c \
#     "mc alias set dev http://minio:9000 boussole-dev boussole-dev-secret && \
#      mc mb --ignore-existing dev/boussole-dev"

# Sessions (cookie httpOnly, TTL glissant).
SESSION_TTL_DAYS=30

# IA (D08) — clés vides en dev tant que la couche ai/ n'est pas branchée (M2).
ANTHROPIC_API_KEY=
FALLBACK_LLM_API_KEY=
EMBEDDINGS_MODEL=voyage-3-large
EMBEDDINGS_DIM=1024

# Matching (D02).
SCORING_CONFIG_PATH=config/scoring-config.json

# Connecteurs derrière feature flags (D04, Q2/Q3).
FEATURE_SOURCE_FRANCE_TRAVAIL=false
FEATURE_SOURCE_GREENHOUSE=false
FEATURE_SOURCE_LEVER=false

# Observabilité (D20) — vides en dev.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Observabilité -----------------------------------------------------------
# SENTRY_DSN est LU (app/core/observability.py). Renseigné, il fait remonter
# erreurs et alertes de conformité — dont « purge RGPD en retard », qui n'a de
# sens que si un humain la reçoit.
# ⚠️ Renseigné SANS l'extra installé (pip install -e '.[observability]'), le
# démarrage ÉCHOUE : se croire observé est pire que ne pas l'être.
# Les données personnelles sont retirées avant envoi (corps de requête,
# cookies, en-têtes d'identité, variables locales des piles).
SENTRY_DSN=

# --- E-mail transactionnel ---------------------------------------------------
# SMTP plutôt qu'une API de fournisseur : le choix du fournisseur est Q15, non
# tranchée. SMTP est le dénominateur commun et ne préempte rien.
# Vide ⇒ aucun envoi, mais journalisé (le message aurait dû partir, ça se voit).
# En dev, mailpit écoute sur 1025 et son interface est sur http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=Boussole <no-reply@boussole.example>

# --- Corpus de démonstration -------------------------------------------------
# Offres FICTIVES (D34), pour éprouver la chaîne et mesurer le matching en
# attendant l'homologation des sources réelles (Q2/Q3). Le connecteur REFUSE
# de s'activer hors développement, quel que soit ce drapeau.
FEATURE_SOURCE_DEMO=true
